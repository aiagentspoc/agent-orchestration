# Azure AI Foundry, OpenAI v1-compatible surface. Copy to .env and fill in.
# Fast model — Scout (SPECIFICATIONS.md §1)
HSE_MODEL_FAST_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
HSE_MODEL_FAST_API_KEY=
HSE_MODEL_FAST_DEPLOYMENT=gpt-5-mini
# Strong model — Writer, QA-Legal and Supervisor (SPECIFICATIONS.md §1, D-H)
HSE_MODEL_STRONG_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
HSE_MODEL_STRONG_API_KEY=
HSE_MODEL_STRONG_DEPLOYMENT=gpt-5.4
# Reasoning effort per role (D24, D-H). Optional. Unset or empty means "use the built-in
# role default" (Writer high, QA-Legal medium, Supervisor medium) -- NOT "no reasoning". Accepted
# values: none, minimal, low, medium, high, xhigh, max; an unrecognised value fails
# the run as CONFIG_ERROR before any token is spent. The Scout has no variable: it
# is an extraction task on gpt-5-mini and stays unset.
#HSE_MODEL_WRITER_REASONING_EFFORT=high
#HSE_MODEL_QA_REASONING_EFFORT=medium
#HSE_MODEL_SUPERVISOR_REASONING_EFFORT=medium

# Cost rates, USD per 1M tokens (SPECIFICATIONS.md §1, §6.9). EXAMPLE VALUES — set real
# rates in .env. Optional; built-in defaults apply when unset. Recorded into
# each draft's telemetry section as the cost basis.
# Fast model — Scout
HSE_COST_FAST_INPUT_USD_PER_MTOK=0.25
HSE_COST_FAST_CACHED_INPUT_USD_PER_MTOK=0.025
HSE_COST_FAST_OUTPUT_USD_PER_MTOK=2.00
# Strong model — Writer, QA-Legal and Supervisor
HSE_COST_STRONG_INPUT_USD_PER_MTOK=1.25
HSE_COST_STRONG_CACHED_INPUT_USD_PER_MTOK=0.125
HSE_COST_STRONG_OUTPUT_USD_PER_MTOK=10.00
